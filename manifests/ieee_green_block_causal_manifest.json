{
  "name": "Adaptive Green Risk Fields v2 block-causal frozen result manifest",
  "causal_policy": "strict_timestamp_block",
  "same_timestamp_policy": "score_all_rows_in_timestamp_block_before_graph_or_history_update",
  "label_release_policy": "release_time_strictly_less_than_candidate_timestamp",
  "dataset": {
    "primary": "IEEE-CIS Fraud Detection",
    "window_size": 100000,
    "windows": [
      0,
      1,
      2,
      3,
      4
    ],
    "split": {
      "train_rows": 60000,
      "validation_rows": 20000,
      "test_rows": 20000
    }
  },
  "green_features": {
    "risk_layers": [
      "card1--addr1",
      "card1--P_emaildomain",
      "card1--DeviceInfo",
      "DeviceInfo--P_emaildomain"
    ],
    "edge_weight": "unit co-occurrence count accumulated from prior timestamp blocks",
    "ego_radius": 2,
    "max_ego_nodes": 100,
    "cap_semantics": "maximum total nodes retained in the two-root ego graph, including candidate endpoints",
    "linear_solver": "dense exact Cholesky on capped local graph",
    "plain_green_lambda": 0.1,
    "history_alpha": 5,
    "adaptive_confidence": "d_v = 5 + sqrt(n_v)",
    "delays_days": [
      0,
      1,
      3,
      7,
      14
    ]
  },
  "modeling": {
    "random_forest": "not used",
    "lightgbm": {
      "n_estimators": 500,
      "learning_rate": 0.05,
      "num_leaves": 31,
      "max_depth": -1,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "reg_lambda": 1.0,
      "early_stopping_rounds": 40,
      "eval_metric": "average_precision",
      "scale_pos_weight": "computed from training prevalence"
    },
    "tail_candidate_fractions": [
      0.025,
      0.05,
      0.1,
      0.2,
      0.3
    ],
    "tail_selection_key": [
      "validation P@1%",
      "validation P@0.5%",
      "validation AUC-PR"
    ],
    "logistic_tail": {
      "class_weight": "balanced",
      "C": 0.5,
      "max_iter": 2000
    },
    "crossfit_oof": {
      "folds": 3,
      "warmup_fraction": 0.5
    }
  },
  "diagnostics": {
    "bootstrap": {
      "replicates": 2000,
      "block_size_rows": 500,
      "resampling": "paired chronological blocks sampled with replacement within each window",
      "interval": "2.5% and 97.5% percentile quantiles"
    },
    "calibration": {
      "ece_bins": 10,
      "ece_binning": "equal-frequency bins on each test window",
      "tail_budgets": [
        0.005,
        0.01,
        0.02,
        0.05
      ]
    }
  },
  "source_scripts": [
    "scripts/run_green_review_graph_history.py",
    "scripts/run_green_review_delay_sweep.py",
    "scripts/run_green_permutation_placebo.py",
    "scripts/run_green_final_bootstrap_ci.py",
    "scripts/run_green_calibration_check.py",
    "scripts/run_green_posterior_uncertainty.py",
    "scripts/plot_delay_auc_sweep.py"
  ],
